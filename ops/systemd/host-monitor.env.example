# FixZone host monitor public runtime configuration example.
# Future production activation target: /etc/fixzone/host-monitor.env
#
# This file is a repository template only. Do not place sensitive values here.
# The systemd service already configures FIXZONE_MONITOR_STATE_DIR.
# Monitor version is managed with the versioned directory/current symlink rollout.

FIXZONE_BACKUP_FRESHNESS_WARNING_HOURS=30
FIXZONE_BACKUP_FRESHNESS_CRITICAL_HOURS=48
