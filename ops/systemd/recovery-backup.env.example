# FixZone recovery backup public runtime configuration example.
# Future production activation target: /etc/fixzone/recovery-backup.env
#
# This file is a repository template only. Do not place sensitive values here.
# Credentials must come from the PostgreSQL container/runtime environment or
# another approved host-local private configuration mechanism outside repository artifacts.

FIXZONE_POSTGRES_MODE=docker-swarm
FIXZONE_POSTGRES_SERVICE=<configured-fixzone-postgres-swarm-service>
FIXZONE_POSTGRES_DATABASE=<configured-database-name>
FIXZONE_POSTGRES_USER=<database-role>
FIXZONE_POSTGRES_EXPECTED_MAJOR=17
FIXZONE_BACKUP_ROOT=/srv/securezone-backups/manual
FIXZONE_UPLOAD_ROOT=/srv/securezone-data/fixzone/uploads
