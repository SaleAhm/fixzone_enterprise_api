generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_OWNER
  EXECUTIVE_SUPER_ADMIN
  TECHNICAL_ADMIN
  OPERATIONS_ADMIN
  ORGANIZATION_ONBOARDING_ADMIN
  PROVIDER_ADMIN
  FINANCE_BILLING_ADMIN
  BILLING_ADMIN
  LEGAL_ADMIN
  ASSIGNMENT_ADMIN
  ASSET_ADMIN
  ASSET_INTELLIGENCE_ADMIN
  COMPLIANCE_ADMIN
  COMPLIANCE_AUDIT_ADMIN
  REGULATORY_ADMIN
  SECURITY_ADMIN
  INVESTIGATION_ADMIN
  RELEASE_OPERATIONS_ADMIN
  BACKUP_RECOVERY_ADMIN
  SUPPORT_ADMIN
  SUPER_ADMIN
  ORG_ADMIN
  DISPATCH_OFFICER
  PROVIDER
  PENDING_PROVIDER
  CITIZEN
}

enum ReportStatus {
  TRIAGE
  ORG_REVIEW
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED_BY_PROVIDER
  CLOSED
}

enum CompletionPolicy {
  CITIZEN_CONFIRMATION_REQUIRED
  ORGANIZATION_CONFIRMATION_REQUIRED
  BOTH_REQUIRED
  CITIZEN_OR_ORGANIZATION
  ADMIN_RESOLUTION_REQUIRED
  AUTO_CLOSE_AFTER_REVIEW_WINDOW
}

enum CompletionDecision {
  PENDING
  CONFIRMED
  VERIFIED
  REWORK_REQUESTED
  DISPUTED
  ESCALATED
}

enum AssignmentOutcome {
  REJECTED
  TIMED_OUT
}

enum OrganizationType {
  FEDERAL
  STATE
  LOCAL_GOVERNMENT
  AGENCY
  CORPORATE
  ESTATE
  CAMPUS
  COMMUNITY
  GOVERNMENT
  FEDERAL_AGENCY
  STATE_AGENCY
  UNIVERSITY
  HOSPITAL
  UTILITY_COMPANY
  PRIVATE_FACILITY
  OTHER
}

enum SubscriptionPlan {
  FREE
  DEMO
  STARTER
  PROFESSIONAL
  GOVERNMENT
  ENTERPRISE
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentEnvironment {
  TEST
  LIVE
}

enum PaymentTransactionStatus {
  INITIALIZED
  PENDING
  PROCESSING
  PAID
  VERIFIED
  FAILED
  ABANDONED
  EXPIRED
  REFUNDED
  REVIEW_REQUIRED
}

enum OrganizationSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PaymentReceiptStatus {
  ISSUED
  REFUNDED
  VOIDED
}

enum ProviderEngagementType {
  INTERNAL_STAFF
  EXTERNAL_CONTRACTOR
}

enum AccountStatus {
  PENDING_INVITE
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  REVOKED
  EXPIRED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum IdentityVerificationStatus {
  UNVERIFIED
  PHONE_VERIFIED
  EMAIL_VERIFIED
  ID_PENDING
  ID_VERIFIED
  FACE_PENDING
  FACE_VERIFIED
  ADDRESS_PENDING
  ADDRESS_VERIFIED
  BUSINESS_VERIFIED
  ENTERPRISE_VERIFIED
}

enum IdentityType {
  INDIVIDUAL
  PROVIDER_INDIVIDUAL
  BUSINESS
  ORGANIZATION_REPRESENTATIVE
  GOVERNMENT_REPRESENTATIVE
}

enum KycSubmissionType {
  GOVERNMENT_ID
  FACE_SELFIE
  ADDRESS_PROOF
  BUSINESS_DOCUMENT
  PROFESSIONAL_LICENSE
}

enum KycSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum EvidenceRelatedEntityType {
  REPORT
  KYC_SUBMISSION
  PROVIDER
  ORGANIZATION
  SERVICE_REQUEST
  DISPUTE
  USER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_CLIENT_RESPONSE
  AWAITING_PROVIDER_RESPONSE
  RESOLVED
  REJECTED
  ESCALATED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PlatformEntitlementPlan {
  FREE
  VERIFIED
  PERSONAL_PLUS
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
  GOVERNMENT
}

enum AdminScopeType {
  PLATFORM
  ORGANIZATION
  JURISDICTION
  MODULE
  ASSET
  REPORT
}

enum DelegatedAuthorityStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum InternalRoleAssignmentStatus {
  ACTIVE
  INACTIVE
  REVOKED
  EXPIRED
  PENDING_APPROVAL
}

enum InternalScopeType {
  PLATFORM
  MODULE
  ORGANIZATION
  JURISDICTION
}

enum PrivilegedApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXECUTION_BLOCKED
}

enum PrivilegedOperationType {
  PLATFORM_SUPER_ADMIN_GRANT
  ROLE_DEFINITION_CHANGE
  PRODUCTION_RESTORE_AUTHORIZATION
  ENTERPRISE_FEATURE_ENABLEMENT
  PAYMENT_CONFIGURATION_CHANGE
  HIGH_VALUE_REFUND_APPROVAL
}

enum RegulatoryCaseStatus {
  DRAFT
  OPEN
  UNDER_REVIEW
  READY_FOR_EXPORT
  EXPORTED
  CLOSED
}

enum RegulatoryExportStatus {
  REQUESTED
  PREPARING
  READY
  FAILED
  CANCELLED
}

enum EvidencePackageStatus {
  DRAFT
  SEALED
  EXPORTED
  VOIDED
}

enum EvidenceAuditAction {
  UPLOADED
  VIEWED
  DOWNLOADED
  EXPORTED
  METADATA_UPDATED
  SOFT_DELETED
  RESTORED
}

enum OwnershipStatus {
  UNKNOWN
  PENDING
  VERIFIED
  DISPUTED
}

enum OwnerType {
  FEDERAL
  STATE
  LGA
  PRIVATE
  NGO
  COMMUNITY
  ENTERPRISE
}

enum AssetClaimStatus {
  PENDING
  APPROVED
  DECLINED
  DISPUTED
  CANCELLED
}

model Organization {
  id                     String             @id @default(cuid())
  name                   String
  type                   OrganizationType   @default(LOCAL_GOVERNMENT)
  status                 OrganizationStatus @default(ACTIVE)
  parentId               String?
  tenantCode             String?
  contactEmail           String?
  contactPhone           String?
  address                String?
  state                  String?
  lga                    String?
  country                String?            @default("Nigeria")
  profileData            Json?
  subscriptionPlan       SubscriptionPlan   @default(FREE)
  billingStatus          BillingStatus      @default(TRIAL)
  subscriptionStartAt    DateTime?
  subscriptionEndAt      DateTime?
  allowedUsers           Int?
  allowedProviders       Int?
  allowedReportsPerMonth Int?
  allowedStorageMb       Int?
  enabledModules         Json?
  isDemo                 Boolean            @default(false)
  demoBatchId            String?
  demoScenario           String?
  demoGeneratedAt        DateTime?
  createdBySuperAdminId  String?
  createdAt              DateTime           @default(now())

  users                User[]
  reports              Report[]
  parent               Organization?                @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children             Organization[]               @relation("OrganizationHierarchy")
  providerLinks        ProviderOrganization[]
  invitations          Invitation[]
  assignedReports      Report[]                     @relation("AssignedOrganizationReports")
  upgradeRequests      OrganizationUpgradeRequest[]
  evidenceRecords      EvidenceRecord[]
  disputeCases         DisputeCase[]
  complianceAuditLogs  ComplianceAuditLog[]
  paymentTransactions  PaymentTransaction[]
  billingSubscriptions OrganizationSubscription[]
  paymentReceipts      PaymentReceipt[]

  @@index([parentId])
  @@index([type])
  @@index([status])
  @@index([subscriptionPlan])
  @@index([billingStatus])
  @@index([isDemo])
  @@index([demoBatchId])
  @@index([demoScenario])
}

model User {
  id                         String                     @id @default(cuid())
  secureZoneId               String?                    @unique
  email                      String?                    @unique
  phone                      String?                    @unique
  firebaseUid                String?                    @unique
  providerId                 String?                    @unique
  passwordHash               String?
  tokenVersion               Int                        @default(0)
  fullName                   String
  role                       UserRole
  accountStatus              AccountStatus              @default(ACTIVE)
  organizationId             String?
  providerEngagementType     ProviderEngagementType?
  serviceCategories          Json?
  coverageAreas              Json?
  profileData                Json?
  subscriptionPlan           SubscriptionPlan?
  identityVerificationStatus IdentityVerificationStatus @default(UNVERIFIED)
  identityVerificationLevel  Int                        @default(0)
  trustScore                 Int                        @default(0)
  identityType               IdentityType               @default(INDIVIDUAL)
  phoneVerifiedAt            DateTime?
  emailVerifiedAt            DateTime?
  idVerifiedAt               DateTime?
  faceVerifiedAt             DateTime?
  addressVerifiedAt          DateTime?
  businessVerifiedAt         DateTime?
  enterpriseVerifiedAt       DateTime?
  serviceZones               Json?
  isDemo                     Boolean                    @default(false)
  demoBatchId                String?
  demoScenario               String?
  demoGeneratedAt            DateTime?
  createdBySuperAdminId      String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  citizenReports          Report[]                    @relation("CitizenReports")
  assignedReports         Report[]                    @relation("AssignedProviderReports")
  notifications           Notification[]
  providerOrganizations   ProviderOrganization[]
  sentInvitations         Invitation[]                @relation("InvitationInviter")
  acceptedInvitations     Invitation[]                @relation("InvitationAcceptedUser")
  kycSubmissions          KycSubmission[]             @relation("KycSubmissionUser")
  reviewedKycSubmissions  KycSubmission[]             @relation("KycSubmissionReviewer")
  loginHistory            LoginHistory[]
  ownedEvidenceRecords    EvidenceRecord[]            @relation("EvidenceOwner")
  uploadedEvidenceRecords EvidenceRecord[]            @relation("EvidenceUploader")
  openedDisputes          DisputeCase[]               @relation("DisputeOpenedBy")
  disputesAgainst         DisputeCase[]               @relation("DisputeAgainstUser")
  reviewedDisputes        DisputeCase[]               @relation("DisputeClosedBy")
  disputeMessages         DisputeMessage[]
  reportMessages          ReportMessage[]
  entitlement             UserEntitlement?
  complianceAuditLogs     ComplianceAuditLog[]        @relation("ComplianceAuditActor")
  requestedPayments       PaymentTransaction[]        @relation("PaymentRequestingUser")
  internalRoleAssignments InternalRoleAssignment[]    @relation("InternalRoleAssignmentUser")
  assignedInternalRoles   InternalRoleAssignment[]    @relation("InternalRoleAssignmentAssignedBy")
  revokedInternalRoles    InternalRoleAssignment[]    @relation("InternalRoleAssignmentRevokedBy")
  requestedApprovals      PrivilegedApprovalRequest[] @relation("PrivilegedApprovalRequester")
  decidedApprovals        PrivilegedApprovalRequest[] @relation("PrivilegedApprovalDecider")
  passwordResetTokens      PasswordResetToken[]

  @@index([organizationId])
  @@index([secureZoneId])
  @@index([identityVerificationStatus])
  @@index([identityType])
  @@index([accountStatus])
  @@index([tokenVersion])
  @@index([isDemo])
  @@index([demoBatchId])
  @@index([demoScenario])
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  userId         String
  tokenDigest    String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  supersededAt   DateTime?
  requestedById  String?
  deliveryStatus String
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, usedAt, supersededAt, expiresAt])
  @@index([expiresAt])
}

model KycSubmission {
  id              String              @id @default(cuid())
  userId          String
  submissionType  KycSubmissionType
  status          KycSubmissionStatus @default(SUBMITTED)
  submittedAt     DateTime            @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  documentUrl     String?
  evidenceFileRef String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user       User  @relation("KycSubmissionUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("KycSubmissionReviewer", fields: [reviewedById], references: [id])

  @@index([userId, status])
  @@index([submissionType])
  @@index([status])
  @@index([reviewedById])
  @@index([submittedAt])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String?
  email         String?
  loginAt       DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  metadata      Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, loginAt])
  @@index([email])
  @@index([success])
  @@index([loginAt])
}

model EvidenceRecord {
  id                   String                    @id @default(cuid())
  ownerUserId          String?
  organizationId       String?
  relatedEntityType    EvidenceRelatedEntityType
  relatedEntityId      String
  fileUrl              String
  fileType             String?
  uploadedById         String?
  uploadedAt           DateTime                  @default(now())
  description          String?
  metadata             Json?
  checksum             String?
  geoLatitude          Float?
  geoLongitude         Float?
  geoAccuracyMeters    Float?
  geoCapturedAt        DateTime?
  geoReceivedAt        DateTime?
  geoSource            String?
  geoCaptureMethod     String?
  geoPermissionState   String?
  geoValidationOutcome String?
  geoDistanceMeters    Float?
  geoTrustOutcome      String?
  geoSchemaVersion     Int                       @default(1)

  ownerUser    User?         @relation("EvidenceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  uploadedBy   User?         @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, uploadedAt])
  @@index([organizationId, uploadedAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([uploadedById])
  @@index([geoLatitude, geoLongitude])
  @@index([geoTrustOutcome])
}

model DisputeCase {
  id                String          @id @default(cuid())
  caseNumber        String          @unique
  openedById        String
  againstUserId     String?
  organizationId    String?
  relatedEntityType String
  relatedEntityId   String
  title             String
  description       String
  status            DisputeStatus   @default(OPEN)
  priority          DisputePriority @default(MEDIUM)
  assignedAdminId   String?
  resolutionSummary String?
  closedById        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  escalatedAt       DateTime?
  closedAt          DateTime?

  openedBy     User             @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  againstUser  User?            @relation("DisputeAgainstUser", fields: [againstUserId], references: [id])
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  closedBy     User?            @relation("DisputeClosedBy", fields: [closedById], references: [id])
  messages     DisputeMessage[]

  @@index([openedById, createdAt])
  @@index([againstUserId])
  @@index([assignedAdminId])
  @@index([organizationId, createdAt])
  @@index([status])
  @@index([relatedEntityType, relatedEntityId])
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  authorId  String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  dispute DisputeCase @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorId], references: [id])

  @@index([disputeId, createdAt])
  @@index([authorId])
}

model UserEntitlement {
  id                        String                  @id @default(cuid())
  userId                    String                  @unique
  plan                      PlatformEntitlementPlan @default(FREE)
  canAccessServiceModule    Boolean                 @default(true)
  canUsePremiumProvider     Boolean                 @default(false)
  canOpenDispute            Boolean                 @default(true)
  canUploadEvidence         Boolean                 @default(true)
  canUsePrioritySupport     Boolean                 @default(false)
  requiredVerificationLevel Int                     @default(0)
  metadata                  Json?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
}

model ComplianceAuditLog {
  id             String    @id @default(cuid())
  actorId        String?
  actorRole      UserRole?
  organizationId String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  actor        User?         @relation("ComplianceAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  description     String?
  module          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id            String    @id @default(cuid())
  role          UserRole
  permissionId  String
  inheritedFrom UserRole?
  createdAt     DateTime  @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
}

model AdminScope {
  id             String         @id @default(cuid())
  userId         String
  scopeType      AdminScopeType
  scopeRef       String?
  organizationId String?
  permissions    Json?
  active         Boolean        @default(true)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, active])
  @@index([scopeType, scopeRef])
  @@index([organizationId])
}

model DelegatedAuthority {
  id             String                   @id @default(cuid())
  userId         String
  delegatedById  String
  organizationId String?
  role           UserRole
  permissions    Json?
  scopes         Json?
  status         DelegatedAuthorityStatus @default(ACTIVE)
  reason         String?
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([userId, status])
  @@index([delegatedById])
  @@index([organizationId])
  @@index([role])
}

model InternalRoleAssignment {
  id                    String                       @id @default(cuid())
  userId                String
  role                  UserRole
  status                InternalRoleAssignmentStatus @default(ACTIVE)
  scopeType             InternalScopeType            @default(PLATFORM)
  scopeRef              String?
  organizationId        String?
  moduleKey             String?
  jurisdiction          Json?
  permissionsSnapshot   Json
  roleDefinitionVersion Int                          @default(1)
  assignedById          String
  reason                String?
  startsAt              DateTime                     @default(now())
  expiresAt             DateTime?
  revokedAt             DateTime?
  revokedById           String?
  revocationReason      String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  user       User  @relation("InternalRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User  @relation("InternalRoleAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedBy  User? @relation("InternalRoleAssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([role, status])
  @@index([scopeType, scopeRef])
  @@index([organizationId])
  @@index([moduleKey])
  @@index([assignedById])
  @@index([expiresAt])
}

model PrivilegedApprovalRequest {
  id               String                   @id @default(cuid())
  operationType    PrivilegedOperationType
  status           PrivilegedApprovalStatus @default(PENDING)
  requesterId      String
  approverId       String?
  targetUserId     String?
  organizationId   String?
  requestedRole    UserRole?
  requestedScope   Json?
  payload          Json?
  reason           String?
  decisionReason   String?
  requestedAt      DateTime                 @default(now())
  decidedAt        DateTime?
  executionBlocked Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  requester User  @relation("PrivilegedApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  approver  User? @relation("PrivilegedApprovalDecider", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([operationType, status])
  @@index([requesterId, requestedAt])
  @@index([approverId, decidedAt])
  @@index([targetUserId])
  @@index([organizationId])
}

model RegulatoryCase {
  id             String               @id @default(cuid())
  caseNumber     String               @unique
  organizationId String?
  reportId       String?
  disputeId      String?
  title          String
  status         RegulatoryCaseStatus @default(DRAFT)
  metadata       Json?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, createdAt])
  @@index([reportId])
  @@index([disputeId])
  @@index([status])
}

model RegulatoryExport {
  id               String                 @id @default(cuid())
  regulatoryCaseId String?
  organizationId   String?
  exportType       String
  format           String
  status           RegulatoryExportStatus @default(REQUESTED)
  requestedById    String?
  reviewedById     String?
  fileUrl          String?
  checksum         String?
  metadata         Json?
  requestedAt      DateTime               @default(now())
  completedAt      DateTime?

  @@index([regulatoryCaseId])
  @@index([organizationId, requestedAt])
  @@index([status])
  @@index([requestedById])
}

model EvidencePackage {
  id                String                @id @default(cuid())
  regulatoryCaseId  String?
  organizationId    String?
  relatedEntityType String?
  relatedEntityId   String?
  status            EvidencePackageStatus @default(DRAFT)
  manifest          Json?
  checksum          String?
  createdById       String?
  sealedById        String?
  createdAt         DateTime              @default(now())
  sealedAt          DateTime?
  updatedAt         DateTime              @updatedAt

  @@index([regulatoryCaseId])
  @@index([organizationId, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([status])
}

model DisputeTimeline {
  id            String   @id @default(cuid())
  disputeCaseId String
  actorId       String?
  action        String
  beforeState   Json?
  afterState    Json?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([disputeCaseId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

model DisputeEvidence {
  id               String   @id @default(cuid())
  disputeCaseId    String
  evidenceRecordId String?
  uploadedById     String?
  description      String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([disputeCaseId, createdAt])
  @@index([evidenceRecordId])
  @@index([uploadedById])
}

model DisputeDecision {
  id            String   @id @default(cuid())
  disputeCaseId String
  decidedById   String?
  decision      String
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([disputeCaseId, createdAt])
  @@index([decidedById])
}

model EvidenceAudit {
  id               String              @id @default(cuid())
  evidenceRecordId String?
  actorId          String?
  actorRole        UserRole?
  action           EvidenceAuditAction
  beforeState      Json?
  afterState       Json?
  reason           String?
  ipAddress        String?
  userAgent        String?
  metadata         Json?
  createdAt        DateTime            @default(now())

  @@index([evidenceRecordId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

model EvidenceAccessLog {
  id               String              @id @default(cuid())
  evidenceRecordId String?
  actorId          String?
  actorRole        UserRole?
  action           EvidenceAuditAction
  ipAddress        String?
  userAgent        String?
  metadata         Json?
  createdAt        DateTime            @default(now())

  @@index([evidenceRecordId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

model Invitation {
  id                    String           @id @default(cuid())
  email                 String?
  phone                 String?
  fullName              String
  role                  UserRole
  status                InvitationStatus @default(PENDING)
  temporaryPasswordHash String?
  inviteCode            String           @unique
  organizationId        String?
  invitedById           String
  acceptedUserId        String?
  metadata              Json?
  expiresAt             DateTime?
  acceptedAt            DateTime?
  declinedAt            DateTime?
  revokedAt             DateTime?
  tokenHash             String?
  resentAt              DateTime?
  lastNotificationAt    DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  invitedBy    User          @relation("InvitationInviter", fields: [invitedById], references: [id])
  acceptedUser User?         @relation("InvitationAcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([organizationId])
  @@index([invitedById])
  @@index([status])
  @@index([role])
  @@index([email])
  @@index([phone])
  @@index([tokenHash])
  @@index([createdAt])
}

model ProviderOrganization {
  id             String   @id @default(cuid())
  providerId     String
  organizationId String
  isPrimary      Boolean  @default(false)
  active         Boolean  @default(true)
  serviceZones   Json?
  createdAt      DateTime @default(now())

  provider     User         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([providerId, organizationId])
  @@index([organizationId, active])
  @@index([providerId, active])
}

model OrganizationUpgradeRequest {
  id                String               @id @default(cuid())
  organizationId    String
  currentPlan       SubscriptionPlan
  requestedPlan     SubscriptionPlan
  requestedByUserId String
  status            UpgradeRequestStatus @default(PENDING)
  requestNote       String?
  reviewNote        String?
  reviewedByUserId  String?
  requestedAt       DateTime             @default(now())
  reviewedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([requestedPlan])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
}

model PaymentTransaction {
  id                       String                   @id @default(cuid())
  organizationId           String
  requestingUserId         String?
  provider                 PaymentProvider
  environment              PaymentEnvironment
  internalReference        String                   @unique
  providerReference        String?
  providerAccessCode       String?
  providerAuthorizationUrl String?
  planCode                 SubscriptionPlan
  amountMinor              Int
  currency                 String
  status                   PaymentTransactionStatus @default(INITIALIZED)
  initializedAt            DateTime                 @default(now())
  paidAt                   DateTime?
  verifiedAt               DateTime?
  failedAt                 DateTime?
  abandonedAt              DateTime?
  refundedAt               DateTime?
  providerEventReference   String?
  lastReconciledAt         DateTime?
  reviewReason             String?
  sanitizedMetadata        Json?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestingUser User?                     @relation("PaymentRequestingUser", fields: [requestingUserId], references: [id], onDelete: SetNull)
  subscription   OrganizationSubscription?
  receipt        PaymentReceipt?

  @@unique([provider, providerReference])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([requestingUserId, createdAt])
  @@index([provider, environment, status])
  @@index([planCode])
}

model OrganizationSubscription {
  id                      String                         @id @default(cuid())
  organizationId          String
  planCode                SubscriptionPlan
  status                  OrganizationSubscriptionStatus @default(ACTIVE)
  currentPeriodStartAt    DateTime
  currentPeriodEndAt      DateTime?
  sourceTransactionId     String?                        @unique
  externalCustomerRef     String?
  externalSubscriptionRef String?
  entitlementAppliedAt    DateTime?
  cancellationRequestedAt DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceTransaction PaymentTransaction? @relation(fields: [sourceTransactionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([planCode])
  @@index([currentPeriodEndAt])
}

model PaymentReceipt {
  id                String               @id @default(cuid())
  transactionId     String               @unique
  organizationId    String
  receiptNumber     String               @unique
  paidAt            DateTime
  organizationName  String
  planCode          SubscriptionPlan
  planNameKey       String
  amountMinor       Int
  currency          String
  provider          PaymentProvider
  providerReference String?
  status            PaymentReceiptStatus @default(ISSUED)
  metadata          Json?
  createdAt         DateTime             @default(now())

  transaction  PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, paidAt])
  @@index([planCode])
}

model JurisdictionZone {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  zoneType       String
  state          String?
  lga            String?
  country        String?  @default("Nigeria")
  boundaryRef    String?
  metadata       Json?
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, active])
  @@index([state, lga])
  @@index([zoneType])
}

model AssetCluster {
  id             String   @id @default(cuid())
  organizationId String?
  category       String?
  locationText   String?
  latitude       Float?
  longitude      Float?
  radiusKm       Float?
  incidentCount  Int      @default(0)
  confidence     Float?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([category])
  @@index([latitude, longitude])
}

model PotentialAsset {
  id              String          @id @default(cuid())
  assetClusterId  String?
  organizationId  String?
  title           String
  category        String?
  locationText    String?
  latitude        Float?
  longitude       Float?
  ownershipStatus OwnershipStatus @default(UNKNOWN)
  ownerType       OwnerType?
  confidence      Float?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([assetClusterId])
  @@index([organizationId, createdAt])
  @@index([ownershipStatus])
  @@index([ownerType])
}

model AssetCandidateOwner {
  id               String          @id @default(cuid())
  potentialAssetId String?
  organizationId   String?
  ownerName        String
  ownerType        OwnerType
  ownershipStatus  OwnershipStatus @default(PENDING)
  confidence       Float?
  source           String?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([potentialAssetId])
  @@index([organizationId])
  @@index([ownerType, ownershipStatus])
}

model OwnershipRecommendation {
  id                   String          @id @default(cuid())
  potentialAssetId     String?
  reportId             String?
  recommendedOwnerType OwnerType?
  recommendedOwnerName String?
  status               OwnershipStatus @default(PENDING)
  confidence           Float?
  rationale            String?
  metadata             Json?
  createdById          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([potentialAssetId])
  @@index([reportId])
  @@index([status])
}

model AssetClaim {
  id                     String           @id @default(cuid())
  potentialAssetId       String?
  claimantUserId         String?
  claimantOrganizationId String?
  ownerType              OwnerType?
  status                 AssetClaimStatus @default(PENDING)
  claimNote              String?
  reviewNote             String?
  reviewedById           String?
  createdAt              DateTime         @default(now())
  reviewedAt             DateTime?
  updatedAt              DateTime         @updatedAt

  @@index([potentialAssetId, status])
  @@index([claimantUserId])
  @@index([claimantOrganizationId])
  @@index([reviewedById])
}

model AssetOwnershipHistory {
  id                String          @id @default(cuid())
  potentialAssetId  String?
  previousOwnerType OwnerType?
  previousOwnerName String?
  newOwnerType      OwnerType?
  newOwnerName      String?
  status            OwnershipStatus @default(PENDING)
  reason            String?
  changedById       String?
  createdAt         DateTime        @default(now())

  @@index([potentialAssetId, createdAt])
  @@index([changedById])
  @@index([status])
}

model Report {
  id                                String              @id @default(cuid())
  title                             String
  description                       String
  category                          String
  location                          String
  locationName                      String?
  locationAddress                   String?
  locationLandmark                  String?
  latitude                          Float?
  longitude                         Float?
  locationAccuracy                  Float?
  locationCapturedAt                DateTime?
  locationReceivedAt                DateTime?
  locationSource                    String?
  locationPermissionState           String?
  locationValidationOutcome         String?
  locationSchemaVersion             Int                 @default(1)
  status                            ReportStatus        @default(PENDING)
  organizationId                    String
  citizenId                         String
  assignedProviderId                String?
  assignedOrganizationId            String?
  organizationAssignedById          String?
  organizationAssignedAt            DateTime?
  organizationAssignmentSource      String?
  assignedAt                        DateTime?
  assignmentDeadlineAt              DateTime?
  lastAssignmentOutcome             AssignmentOutcome?
  lastAssignmentReason              String?
  lastAssignmentAt                  DateTime?
  lastAssignmentProviderId          String?
  completionNote                    String?
  completionImageUrl                String?
  completionImagePath               String?
  completionLatitude                Float?
  completionLongitude               Float?
  completionAccuracy                Float?
  completionLocationCapturedAt      DateTime?
  completionLocationSource          String?
  evidenceImageUrl                  String?
  evidenceImagePath                 String?
  completedByProviderAt             DateTime?
  citizenRating                     Int?
  citizenFeedback                   String?
  completionRejectionReason         String?
  completionPolicy                  CompletionPolicy?
  completionPolicySource            String?
  completionReviewState             String?
  completionReviewDeadlineAt        DateTime?
  completionReviewProcessedAt       DateTime?
  completionFallbackRule            String?
  completionFinalActorType          String?
  completionGovernanceHoldReason    String?
  citizenCompletionDecision         CompletionDecision?
  citizenCompletionDecidedAt        DateTime?
  organizationCompletionDecision    CompletionDecision?
  organizationCompletionDecidedAt   DateTime?
  organizationCompletionDecidedById String?
  organizationCompletionReason      String?
  completionFinalizedAt             DateTime?
  completionFinalizedById           String?
  completionFinalizedByRole         UserRole?
  completionClosureReason           String?
  completionDisputeReason           String?
  isDemo                            Boolean             @default(false)
  demoBatchId                       String?
  demoScenario                      String?
  demoGeneratedAt                   DateTime?
  createdBySuperAdminId             String?
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime            @updatedAt

  organization         Organization     @relation(fields: [organizationId], references: [id])
  assignedOrganization Organization?    @relation("AssignedOrganizationReports", fields: [assignedOrganizationId], references: [id])
  citizen              User             @relation("CitizenReports", fields: [citizenId], references: [id])
  assignedProvider     User?            @relation("AssignedProviderReports", fields: [assignedProviderId], references: [id])
  notifications        Notification[]
  activities           ReportActivity[]
  messages             ReportMessage[]

  @@index([organizationId])
  @@index([citizenId])
  @@index([assignedProviderId])
  @@index([assignedOrganizationId])
  @@index([status])
  @@index([completionPolicy])
  @@index([completionReviewState])
  @@index([completionReviewDeadlineAt])
  @@index([isDemo])
  @@index([demoBatchId])
  @@index([demoScenario])
}

model ReportMessage {
  id             String   @id @default(cuid())
  reportId       String
  organizationId String
  authorId       String
  authorRole     UserRole
  authorName     String?
  message        String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@index([organizationId, createdAt])
  @@index([authorId, createdAt])
}

model ReportActivity {
  id             String        @id @default(cuid())
  reportId       String
  organizationId String
  actorUserId    String?
  actorRole      UserRole?
  actorName      String?
  action         String
  fromStatus     ReportStatus?
  toStatus       ReportStatus?
  providerId     String?
  reason         String?
  note           String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
}

model PublicSuccessStory {
  id                String    @id @default(cuid())
  title             String
  summary           String
  category          String
  broadLocation     String
  organizationName  String?
  outcome           String
  resolvedAt        DateTime?
  approvedForPublic Boolean   @default(false)
  approvedBy        String?
  approvedAt        DateTime?
  publicImage       String?
  displayOrder      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([approvedForPublic, displayOrder])
  @@index([approvedAt])
  @@index([category])
}

model Notification {
  id                    String    @id @default(cuid())
  userId                String
  reportId              String?
  type                  String
  title                 String
  message               String
  read                  Boolean   @default(false)
  isDemo                Boolean   @default(false)
  demoBatchId           String?
  demoScenario          String?
  demoGeneratedAt       DateTime?
  createdBySuperAdminId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id])

  @@index([userId, read])
  @@index([reportId])
  @@index([createdAt])
  @@index([isDemo])
  @@index([demoBatchId])
  @@index([demoScenario])
}

model DemoAuditLog {
  id          String   @id @default(cuid())
  action      String
  actorUserId String
  demoBatchId String?
  scenario    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([actorUserId])
  @@index([demoBatchId])
  @@index([createdAt])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PlatformBackup {
  id           String    @id @default(cuid())
  fileName     String    @unique
  filePath     String
  sizeBytes    Int
  status       String    @default("READY")
  createdById  String
  restoredAt   DateTime?
  restoredById String?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([createdById])
  @@index([status])
}
