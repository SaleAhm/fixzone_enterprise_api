# FixZone maintenance workflow is the active commercial module.
# Enterprise foundation APIs are default-off. Accepted enabled value: true.
SECUREZONE_ENTERPRISE_FOUNDATIONS_ENABLED=false
SECUREZONE_ENTERPRISE_GOVERNANCE_ENABLED=false
SECUREZONE_INVESTIGATION_ENABLED=false
SECUREZONE_REGULATORY_GOVERNANCE_ENABLED=false
SECUREZONE_ASSET_INTELLIGENCE_ENABLED=false
SECUREZONE_EVIDENCE_EXPORT_WORKFLOWS_ENABLED=false

# Geo-Tagged Evidence & Location Trust
# Coordinates are client-supplied and compared for consistency; they are not proof of authenticity.
FIXZONE_GEO_MAX_ACCURACY_METERS=10000
FIXZONE_GEO_WARNING_DISTANCE_METERS=250
FIXZONE_GEO_STALE_CAPTURE_MINUTES=1440
FIXZONE_GEO_EXIF_CONFLICT_DISTANCE_METERS=100

# Production migrations must be an explicit release operation:
# backup -> inspect migration plan -> approval -> npm run migrate:release -> start/restart -> smoke test.

# Payments, Subscriptions & Commercial Monetization
# Default-off. Enable only after provider credentials, callback URLs and launch approval are configured.
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=PAYSTACK
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_replace_with_approved_secret
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_approved_public_key
PAYMENTS_CALLBACK_BASE_URL=http://localhost:3000
PAYMENTS_HTTP_TIMEOUT_MS=8000
PAYMENTS_RECONCILIATION_BATCH_SIZE=25
PAYMENTS_RECONCILIATION_MIN_AGE_MINUTES=30
PAYMENTS_GRACE_PERIOD_DAYS=0

# Placeholder test plan references. Do not use these values in live mode.
PAYSTACK_PLAN_STARTER_TEST_REF=
PAYSTACK_PLAN_PROFESSIONAL_TEST_REF=
PAYSTACK_PLAN_GOVERNMENT_TEST_REF=
PAYSTACK_PLAN_ENTERPRISE_TEST_REF=

# Password recovery delivery
# Default-off. Configure only after sender domain authentication and controlled UAT approval.
PASSWORD_RESET_DELIVERY_ENABLED=false
PASSWORD_RESET_DELIVERY_PROVIDER=smtp
PASSWORD_RESET_SMTP_HOST=smtp.example.invalid
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_SECURE=false
PASSWORD_RESET_SMTP_USERNAME=replace_with_approved_username
PASSWORD_RESET_SMTP_PASSWORD=replace_with_approved_password
PASSWORD_RESET_SMTP_FROM="SecureZone Account Recovery <no-reply@example.invalid>"
PASSWORD_RESET_SMTP_REPLY_TO=
PASSWORD_RESET_PUBLIC_ORIGIN=http://localhost:3000
PASSWORD_RESET_ALLOWED_ORIGINS=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_DELIVERY_TIMEOUT_MS=5000
PASSWORD_RESET_DELIVERY_RETRY_ATTEMPTS=1
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=120
PASSWORD_RESET_REQUEST_DAILY_LIMIT=5
PASSWORD_RESET_DELIVERY_LOG_LEVEL=safe
PASSWORD_RESET_DELIVERY_TEST_MODE=false
