# FixZone maintenance workflow is the active commercial module.
# Enterprise foundation APIs are default-off. Accepted enabled value: true.
SECUREZONE_ENTERPRISE_FOUNDATIONS_ENABLED=false
SECUREZONE_ENTERPRISE_GOVERNANCE_ENABLED=false
SECUREZONE_INVESTIGATION_ENABLED=false
SECUREZONE_REGULATORY_GOVERNANCE_ENABLED=false
SECUREZONE_ASSET_INTELLIGENCE_ENABLED=false
SECUREZONE_EVIDENCE_EXPORT_WORKFLOWS_ENABLED=false

# Geo-Tagged Evidence & Location Trust
# Coordinates are client-supplied and compared for consistency; they are not proof of authenticity.
FIXZONE_GEO_MAX_ACCURACY_METERS=10000
FIXZONE_GEO_WARNING_DISTANCE_METERS=250
FIXZONE_GEO_STALE_CAPTURE_MINUTES=1440
FIXZONE_GEO_EXIF_CONFLICT_DISTANCE_METERS=100

# Production migrations must be an explicit release operation:
# backup -> inspect migration plan -> approval -> npm run migrate:release -> start/restart -> smoke test.
